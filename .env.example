# ==============================================================================
# NightWatch: A Sleep-Aware Digital Twin for Proactive Hypertension Risk Prediction
# Environment Configuration Template
# ==============================================================================

# Application & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173

# Database (Default: SQLite local database; switchable to PostgreSQL)
DATABASE_URL=sqlite:///./nightwatch.db
# PostgreSQL example (placeholders only):
# DATABASE_URL=postgresql+psycopg2://<username>:<password>@localhost:5432/<dbname>

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Clinical Risk Thresholds (Configurable)
RISK_THRESHOLD_MODERATE=0.35
RISK_THRESHOLD_HIGH=0.65

# Alert Deduplication Cooldown (Hours before same-patient repeated alert trigger)
ALERT_COOLDOWN_HOURS=24

# Simulator Defaults
SIMULATION_PATIENT_COUNT=200
SIMULATION_HISTORY_DAYS=120
SIMULATION_STEP_SECONDS=10
SIMULATION_RANDOM_SEED=42

# ML Model Artifacts Path
ML_ARTIFACTS_DIR=ml/artifacts
MODEL_VERSION=1.1.0
